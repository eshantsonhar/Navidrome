[Unit]
Description=BlackBerry Music Intelligence Service
After=network.target navidrome.service
Wants=navidrome.service

[Service]
Type=simple
User=blackberry
Group=blackberry
WorkingDirectory=/mnt/music/script_music_reccomendations
Environment="PATH=/tmp/blackberry-music-test-venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/tmp/blackberry-music-test-venv/bin/python3 /mnt/music/script_music_reccomendations/run.py status
Restart=on-failure
RestartSec=30

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
MemoryLimit=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
